#
# Career Scout + JobTracker (merged)
#
# This repo runs an Express server + Vite client.
# - Drizzle ORM powers the "Career Scout" tables
# - Prisma ORM powers the "JobTracker" tables
#
# Local dev recommendation:
# - Use Docker Postgres via `docker-compose.yml`
# - Put your local settings in `.env.local` (gitignored)
#

#
# Database (required)
#
# Canonical DB connection string for the whole app.
# (For the Docker local setup, use the defaults below.)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/jobtracker_local"

# Optional: JobTracker/Prisma DB URL override.
# If unset, JobTracker derives from DATABASE_URL plus JOBTRACKER_DB_SCHEMA.
JOBTRACKER_DATABASE_URL=""

# Prisma schema target (Postgres schema).
# NOTE: With Prisma driver adapters, `public` is the most compatible choice.
# You can still create/use `jobtracker` schema, but set this to `jobtracker` only
# if your runtime Prisma configuration supports it.
JOBTRACKER_DB_SCHEMA="public"

#
# Sessions / cookies (required in production; fine in dev too)
#
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: where connect-pg-simple stores sessions (defaults to public)
SESSION_DB_SCHEMA="public"

#
# Startup DB sync
#
# In production you may want this true. For local dev, `npm run dev:local` runs the pushes.
CAREER_SCOUT_DB_PUSH_ON_START="false"

#
# Local dev: no-login auth bypass (dev-only)
#
# Production is unaffected. In non-production, default is enabled unless explicitly set false.
CAREER_SCOUT_DEV_AUTH_BYPASS="true"
CAREER_SCOUT_DEV_ADMIN_ID="dev_admin"
CAREER_SCOUT_DEV_ADMIN_EMAIL="dev-admin@career-scout.local"
CAREER_SCOUT_DEV_ADMIN_NAME="Dev Admin"

#
# Optional: enable demo login endpoint in production (explicit opt-in)
#
CAREER_SCOUT_ALLOW_DEMO_LOGIN="false"

#
# OpenAI (optional; AI features will return 503 if missing)
#
AI_INTEGRATIONS_OPENAI_API_KEY=""
AI_INTEGRATIONS_OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

#
# JobTracker integrations (optional)
#
JOBTRACKER_OPENAI_API_KEY=""
JOBTRACKER_OPENAI_MODEL="gpt-4o-mini"
JOBTRACKER_SERPAPI_API_KEY=""
JOBTRACKER_AUTH_GOOGLE_ID=""
JOBTRACKER_AUTH_GOOGLE_SECRET=""

