{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["...", "npm --prefix apps/jobtracker ci"]
    },
    "build": {
      "commands": ["...", "npm run build", "npm --prefix apps/jobtracker run build"]
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}

