# Career Scout (existing)
#
# Required: Postgres connection for Career Scout (Drizzle tables in `public` schema).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: auto-apply Drizzle schema on startup (recommended for first Railway deploy)
CAREER_SCOUT_DB_PUSH_ON_START="true"

# Optional (Replit AI Integrations; keep empty if unused)
AI_INTEGRATIONS_OPENAI_API_KEY=""
AI_INTEGRATIONS_OPENAI_BASE_URL=""

# JobTracker module (new)
#
# Enable the embedded JobTracker sub-app at /jobtracker.
JOBTRACKER_ENABLED="true"
# Autostart JobTracker as a child process when Career Scout boots.
JOBTRACKER_AUTOSTART="true"
# Internal port used by the JobTracker Next.js server (Career Scout proxies to it).
JOBTRACKER_INTERNAL_PORT="3001"

# JobTracker database (Prisma)
# Strongly recommended: use a separate Postgres schema to avoid table collisions with Career Scout.
JOBTRACKER_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=jobtracker"

# JobTracker auth (Auth.js / NextAuth)
# Required in production.
JOBTRACKER_AUTH_SECRET="replace-with-a-long-random-string"
# Must include the /jobtracker base path because the app is mounted there.
JOBTRACKER_AUTH_URL="http://localhost:5000/jobtracker"
# Set to true on platforms behind a proxy (Railway).
JOBTRACKER_AUTH_TRUST_HOST="true"

# Optional: Google OAuth (Gmail integration)
JOBTRACKER_AUTH_GOOGLE_ID=""
JOBTRACKER_AUTH_GOOGLE_SECRET=""

# Optional: OpenAI (AI writing + match deep dive)
JOBTRACKER_OPENAI_API_KEY=""
JOBTRACKER_OPENAI_MODEL="gpt-4o-mini"

# Optional: Job source connector keys
JOBTRACKER_SERPAPI_API_KEY=""

# Optional: demo login toggles
JOBTRACKER_ALLOW_DEV_LOGIN="true"
JOBTRACKER_ALLOW_DEMO_LOGIN="true"

