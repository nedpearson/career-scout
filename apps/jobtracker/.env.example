# Database
# When embedded in Career Scout, prefer JOBTRACKER_DATABASE_URL so Career Scout can keep its own DATABASE_URL.
JOBTRACKER_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=jobtracker"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth (Auth.js / NextAuth)
# Embedded mode (recommended):
JOBTRACKER_AUTH_SECRET="replace-with-a-long-random-string"
# Required in production so Auth.js can generate correct callback URLs/cookies
JOBTRACKER_AUTH_URL="http://localhost:5000/jobtracker"
# Set to "true" on platforms behind a proxy (Railway, etc.)
JOBTRACKER_AUTH_TRUST_HOST="true"

# Standalone fallbacks (optional):
AUTH_SECRET=""
AUTH_URL="http://localhost:3000/jobtracker"
AUTH_TRUST_HOST="true"

# Google OAuth (Gmail integration)
JOBTRACKER_AUTH_GOOGLE_ID=""
JOBTRACKER_AUTH_GOOGLE_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: OpenAI (AI writing + match deep dive)
JOBTRACKER_OPENAI_API_KEY=""
JOBTRACKER_OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Job source connectors
# Some providers require API keys; leave blank if unused.
JOBTRACKER_SERPAPI_API_KEY=""
SERPAPI_API_KEY=""

# Dev-only: allow email-only demo login (no Google OAuth needed)
JOBTRACKER_ALLOW_DEV_LOGIN="true"
ALLOW_DEV_LOGIN="true"

# Public demo: allow one-click demo account login from /signin
JOBTRACKER_ALLOW_DEMO_LOGIN="true"
ALLOW_DEMO_LOGIN="true"
